# --- Private: never publish ---
# Project seed / internal strategy (pre-public planning docs)
cognitive-loops-seed.md
internal/
sharing/

# Imported mechanisms from private projects (staged for later release, if ever)
imports/
mechanisms/

# Instrument internals: scoring, thresholds, validation pipelines
# (open-method, closed-pipeline until validated)
pipelines/private/
validation/

# Proprietary measurement providers: the whole folder is private EXCEPT the
# public stub + README that document the fence.
src/gyre/providers/proprietary/*
!src/gyre/providers/proprietary/__init__.py
!src/gyre/providers/proprietary/README.md

# Proprietary meta-controllers (Tier 3): same fence, one layer up.
src/gyre/control/proprietary/*
!src/gyre/control/proprietary/__init__.py
!src/gyre/control/proprietary/README.md

# Private experiment drivers and verification scaffolds. Public scripts must
# run against registry/interface seams without importing private machinery.
scripts/private/
scripts/*proprietary*.py
experiments/private/
tests/private/
tests/test_proprietary_*.py

# Labelled trace corpora used to validate measurements (a separate asset)
traces/private/
benchmarks/private/

# Contributors may develop proprietary contenders here. The directory itself
# is ignored; only deliberately generated receipts under benchmarks/submissions
# should be submitted.
contenders/private/

# Video source clips and masters are bulk data stored on D:. Keep only scripts,
# prompts, captions, pointers, and render receipts in the repository.
videos/raw/
videos/renders/
videos/exports/
videos/**/*.mp4
videos/**/*.mov
videos/**/*.mkv
videos/**/*.webm
videos/**/*.wav
videos/**/*.flac

# --- Session/agent artefacts ---
.remember/
.logs/
.tmp/
AGENT_CONTROL.md

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Environment / secrets ---
.env
.env.*
*.local

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Ecosystem pointer files injected by a private tooling repo; they describe
# local machine paths and are not part of the public project.
CLAUDE.md
AGENTS.md
